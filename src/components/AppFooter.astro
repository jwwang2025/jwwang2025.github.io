---
import { siteConfig } from '@/config'
---

<footer class="footer">
  <div class="footer-inner">
    <p class="footer-copy">
      &copy; {new Date().getFullYear()} {siteConfig.author.name} — Built with Astro
    </p>
    <div class="footer-links">
      <a href={siteConfig.author.links.github} class="footer-link">GitHub</a>
      <a href={siteConfig.author.links.zhihu} class="footer-link">Zhihu</a>
      <a href={`mailto:${siteConfig.author.links.email}`} class="footer-link">Email</a>
    </div>
  </div>
</footer>
