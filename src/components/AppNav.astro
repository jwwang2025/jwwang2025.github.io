---
import { siteConfig } from '@/config'

export interface Props {
  currentPath?: string
}

const { currentPath = '/' } = Astro.props
---

<nav class="site-nav">
  <div class="nav-shell">
    <a href="/" class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 2C21 2 38 10 38 21C38 32 21 40 21 40C21 40 4 32 4 21C4 10 21 2 21 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M21 12V30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M14 18L21 12L28 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M14 24L21 30L28 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="brand-copy">
        <strong>jwwang.log</strong>
        <em class="optional-label">AI Infra & Systems</em>
      </div>
    </a>

    <div class="nav-center">
      {siteConfig.navLinks.map((link) => {
        const isActive = link.href === '/' 
          ? currentPath === '/' 
          : currentPath.startsWith(link.href)
        return (
          <a
            href={link.href}
            class={`nav-link ${isActive ? 'nav-link-active' : ''}`}
          >
            {link.label}
          </a>
        )
      })}
    </div>

    <div class="nav-actions">
      <div class="theme-toggle" data-theme="dark">
        <div class="theme-toggle-track">
          <button class="theme-toggle-option active" aria-label="浅色模式">L</button>
          <button class="theme-toggle-option" aria-label="深色模式">D</button>
          <button class="theme-toggle-option theme-toggle-terminal" aria-label="终端模式">&gt;_</button>
        </div>
        <div class="theme-toggle-glow"></div>
        <div class="theme-toggle-indicator"></div>
      </div>
      <a href={siteConfig.author.links.github} class="icon-button optional-github" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>
</nav>
