---
// 作者侧边栏组件，展示作者信息、阅读进度和社交链接
import { siteConfig } from '@/config'

export interface Props {
  progress?: number
}

const { progress = 0 } = Astro.props
---

<aside class="author-sidebar">
  <div class="post-author-card">
    <div class="post-author-head">
      <span>作者</span>
      <strong>{siteConfig.author.name}</strong>
    </div>
    <a href="/about" class="post-author-identity">
      <div class="post-author-orbit" style={{ '--reading-progress': progress } as any}>
        <img src={siteConfig.author.avatar} alt={siteConfig.author.name} class="post-author-avatar" />
      </div>
      <div class="post-author-name">
        <strong>{siteConfig.author.name}</strong>
        <small>{siteConfig.author.nameEn}</small>
      </div>
      <span class="post-author-arrow">-&gt;</span>
    </a>
    <p class="post-author-role">{siteConfig.author.role}</p>
    <div class="post-author-focus">
      {siteConfig.author.focus.map((f) => (
        <span>{f}</span>
      ))}
    </div>
    <div class="post-author-progress">
      <div>
        <span>阅读进度</span>
        <a href="#" onclick="window.scrollTo({top: document.body.scrollHeight, behavior: 'smooth'})">到底部</a>
      </div>
      <div class="post-author-progress-track">
        <span style={{ width: `${progress}%` }}></span>
      </div>
    </div>
    <div class="post-author-links">
      <a href={siteConfig.author.links.github} aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <a href={siteConfig.author.links.zhihu} aria-label="Zhihu">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 2.95-1.75 3.95-.96.99-2.23 1.67-3.89 1.67-.58 0-1.14-.07-1.68-.2-.55.13-1.07.33-1.56.58-.49.25-1.01.45-1.57.58-.54.13-1.01.2-1.41.2-.34 0-.64-.03-.89-.08.32 1.58 1.35 2.85 2.75 3.59 1.72.88 3.88.93 5.82.26 1.22-.42 2.21-1.17 2.95-2.12.75-.96 1.26-2.09 1.48-3.39.08-.46.13-.91.13-1.35 0-.52-.07-1.01-.2-1.49-.15-.5-.38-.94-.68-1.31-.3-.37-.66-.66-1.08-.86-.42-.2-.89-.3-1.4-.3-.42 0-.8.06-1.14.16.14.39.21.8.21 1.22 0 .83-.27 1.58-.78 2.21-.52.63-1.23 1.12-2.09 1.41-.87.29-1.75.44-2.65.44-.18 0-.35-.01-.52-.03.57-1.29 1.55-2.31 2.81-2.91.87-.41 1.93-.62 3.13-.62.63 0 1.21.08 1.74.21z"/>
        </svg>
        Zhihu
      </a>
      <a href={`mailto:${siteConfig.author.links.email}`} aria-label="Email">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        Email
      </a>
    </div>
  </div>
</aside>
