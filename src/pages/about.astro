---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TopicChip from '@/components/TopicChip.astro'
import ArticleLine from '@/components/ArticleLine.astro'
import { siteConfig } from '@/config'
import { getAllPosts } from '@/utils/blog'

const posts = await getAllPosts()
const recentPosts = posts.slice(0, 5)

const tools = [
  { name: 'Python', icon: '/icons/python.svg' },
  { name: 'Java', icon: '/icons/openjdk.svg' },
  { name: 'PyTorch', icon: '/icons/pytorch.svg' },
  { name: 'FastAPI', icon: '/icons/fastapi.svg' },
  { name: 'ChatGPT', icon: '/icons/chatgpt.svg' },
  { name: 'TypeScript', icon: '/icons/typescript.svg' },
  { name: 'Codex', icon: '/icons/codex.svg' },
  { name: 'Hugging Face', icon: '/icons/huggingface.svg' },
  { name: 'WorkBuddy', icon: '/icons/workbuddy.svg' },
  { name: 'Git', icon: '/icons/git.svg' },
  { name: 'GitHub', icon: '/icons/github.svg' },
  { name: 'Trae', icon: '/icons/trae.svg' },
  { name: 'VS Code', icon: '/icons/visualstudiocode.svg' },
  { name: 'DeepSeek', icon: '/icons/deepseek.svg' },
]
---

<BaseLayout title="关于" description="关于我的个人信息" pageClass="about-page">
  <div class="page-frame">
    <div class="about-hero">
      <div class="about-profile">
        <img src={siteConfig.author.avatar} alt={siteConfig.author.name} />
        <div class="about-identity">
          <h1>{siteConfig.author.name}</h1>
          <p class="about-en">{siteConfig.author.nameEn}</p>
          <p class="about-summary">
            北京理工大学在读硕士，AI 应用开发工程师 · AI Agent 构建者。专注于 Agent Memory、AI Agent 与全栈开发方向。热爱技术，乐于分享，希望通过博客记录成长轨迹，与大家共同进步。
          </p>
          <div class="about-actions">
            <a href={siteConfig.author.links.github} class="text-link">GitHub</a>
            <a href={siteConfig.author.links.zhihu} class="text-link">Zhihu</a>
            <a href={`mailto:${siteConfig.author.links.email}`} class="text-link">Email</a>
          </div>
        </div>
      </div>

      <div class="about-snapshot">
        <p class="snapshot-label">站点概览</p>
        <div class="snapshot-grid">
          <div>
            <span>{posts.length}</span>
            <em>文章</em>
          </div>
          <div>
            <span>3</span>
            <em>年</em>
          </div>
          <div>
            <span>820+</span>
            <em>关注者</em>
          </div>
          <div>
            <span>50K+</span>
            <em>阅读量</em>
          </div>
        </div>
        <p class="snapshot-note">数据更新于 {new Date().toLocaleDateString()}</p>
      </div>
    </div>

    <div class="about-layout">
      <div>
        <section class="site-block reveal-item">
          <p class="block-eyebrow">关注方向</p>
          <div class="focus-grid">
            <div class="focus-card">
              <small>01</small>
              <span>Agent Memory</span>
              <h3>记忆系统</h3>
              <p>记忆系统、上下文工程与长期记忆管理，让 Agent 在试错与迭代中持续累积经验</p>
            </div>
            <div class="focus-card">
              <small>02</small>
              <span>AI Agent</span>
              <h3>AI Agent 构建</h3>
              <p>智能体框架、工具调用、规划与多智能体协作，把模型能力变成可用的产品</p>
            </div>
            <div class="focus-card">
              <small>03</small>
              <span>Full-Stack</span>
              <h3>全栈开发</h3>
              <p>TypeScript / Python 一体化开发，从接口、前端到部署交付完整应用</p>
            </div>
            <div class="focus-card">
              <small>04</small>
              <span>AI 应用</span>
              <h3>RAG 应用落地</h3>
              <p>RAG、评估体系与工程化实践，关注真实场景中的效果与稳定性</p>
            </div>
          </div>
        </section>

        <section class="site-block reveal-item">
          <p class="block-eyebrow">技术栈和工具</p>
          <div class="stack-panel">
            <div class="stack-icons">
              {tools.map((tool) => (
                <span class="stack-icon">
                  <img src={tool.icon} alt={tool.name} title={tool.name} loading="lazy" />
                </span>
              ))}
            </div>
          </div>
        </section>

        <section class="site-block reveal-item">
          <p class="block-eyebrow">经历</p>
          <div class="timeline">
            <div class="timeline-card">
              <div class="timeline-logo">
                <img src="/badges/bit-badge.svg" alt="北京理工大学校徽" />
              </div>
              <div>
                <time>2026.09 – 2029.06</time>
                <h3>北京理工大学 <span>计算机硕士在读</span></h3>
                <p class="timeline-role">AI 应用开发工程师 · AI Agent 构建者</p>
                <p class="timeline-desc">研究方向：Agent Memory 与 AI Agent 工程实践</p>
              </div>
            </div>
            <div class="timeline-card">
              <div class="timeline-logo">
                <img src="/badges/xju-badge.png" alt="新疆大学校徽" />
              </div>
              <div>
                <time>2022.09 – 2026.06</time>
                <h3>新疆大学 <span>软件工程本科</span></h3>
                <p class="timeline-role">软件工程专业</p>
                <p class="timeline-desc">主修课程：数据结构、操作系统、计算机网络、人工智能等</p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div>
        <section class="site-block reveal-item">
          <p class="block-eyebrow">近期文章</p>
          <div class="article-stream">
            {recentPosts.map((post) => (
              <ArticleLine post={post} />
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
